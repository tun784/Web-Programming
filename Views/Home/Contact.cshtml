@{
    ViewData["Title"] = "Liên hệ";
}

<style>
    .centered-contact {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .contact-box {
        background: #f8f9fa;
        border: 2px solid #343a40;
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        text-align: center;
        width: 100%;
        max-width: 500px;
    }

        .contact-box h2 {
            color: #343a40;
            margin-bottom: 20px;
        }

        .contact-box p {
            font-size: 18px;
            color: #555;
        }

        .contact-box strong {
            color: #007bff;
        }
</style>

<div class="centered-contact">
    <div class="contact-box">
        <h2>Thông tin liên hệ</h2>
        <p>Họ và tên: <strong>Nguyễn Tuấn Hưng</strong></p>
        <p>Địa chỉ: <strong>Phúc Yên</strong></p>
    </div>
</div>
