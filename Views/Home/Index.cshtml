@using Microsoft.AspNetCore.Http
@model IEnumerable<BanHoa.Models.Product>
@{
    ViewData["Title"] = "Flower Shop";
    var customerId = Context.Session.GetInt32("CustomerID");
}

<div class="d-flex justify-content-end mb-4">
    @if (customerId != null)
    {
        <form asp-controller="Account" asp-action="SignOut" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-danger me-2">Log Out</button>
        </form>
    }
    else
    {
        <a asp-controller="Account" asp-action="SignIn" class="btn btn-outline-primary me-2">Sign In</a>
        <a asp-controller="Account" asp-action="SignUp" class="btn btn-outline-secondary me-2">Sign Up</a>
    }
    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-success">Cart</a>
</div>

<h2>Our Flowers</h2>
<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="~/images/@product.ImageURL" class="card-img-top mx-auto d-block" alt="@product.ProductName" style="max-width:200px; max-height:200px; object-fit:cover;" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.ProductName</h5>
                    <p class="card-text mt-auto">Price: @product.Price.ToString("C0")</p>
                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@product.ProductID" class="btn btn-primary mt-2">
                        Add to Cart
                    </a>
                </div>
            </div>
        </div>
    }
</div>
